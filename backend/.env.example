# Copy to .env for local use. NEVER commit .env or put real values in this file.
# Prototype default is dry-run: nothing is emailed, messages are printed and saved to backend/outbox/.
EMAIL_MODE=dry-run
# Only needed if you later switch EMAIL_MODE to "resend" (needs an account the owner opens):
RESEND_API_KEY=your-key-goes-here
ENQUIRY_TO_EMAIL=you@example.com
ENQUIRY_FROM_EMAIL=enquiries@your-domain.example
